# web-hrms environment. Copy to .env.local for local development.
# Production: set the same names in the Vercel / Render / Cloudflare dashboards.
# Generate secrets with:  openssl rand -base64 48 | tr -d '\n=+/' ; echo
# Never reuse local secrets in production.

# ── Web (Next.js on Vercel) ────────────────────────────────────────────────
# Server-only: where proxy.ts forwards /api/* (PLAN.md K7).
API_ORIGIN=http://localhost:8080
# >= 32 chars. The SAME value must be set on the Rust server.
PROXY_SECRET=
# Public VAPID key for Web Push (P9). Safe to expose.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# ── Server (Rust on Render) ────────────────────────────────────────────────
# PORT is not set here: Render injects it; the server defaults to 8080 locally
# (and Next.js would also pick it up from this shared file).
# The public web origin. https:// in production.
APP_ORIGIN=http://localhost:3000
# info | debug | warn ; LOG_FORMAT=json on Render
RUST_LOG=info,tower_http=info
LOG_FORMAT=
# P1: new Supabase project → Project Settings → Database → Session pooler (port 5432).
DATABASE_URL=
DATABASE_MAX_CONNECTIONS=5
# >= 32 chars, different from PROXY_SECRET. Keys IP hashes for rate limits.
APP_SECRET=
# P2: WebAuthn relying party = the web host (no scheme, no port).
WEBAUTHN_RP_ID=localhost
# P9: Web Push private key + contact.
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# P7: Cloudflare R2 (files, payslips, device photos).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# P5: eSSL device ingest. Both >= 32 chars. Relay secret also goes into the Worker.
DEVICE_INGEST_SECRET=
DEVICE_RELAY_SECRET=
DEVICE_PHOTO_RETENTION_DAYS=90
ORG_TIMEZONE=Asia/Kolkata
# Internal login alias domain (never a real mailbox).
ALIAS_DOMAIN=staff.hrms.invalid

# ── One-time bootstrap (P1: cargo run --bin bootstrap) ─────────────────────
# Remove ADMIN_PASSWORD after the first successful run.
ORG_CODE=
ORG_NAME=
ADMIN_EMPLOYEE_CODE=
ADMIN_NAME=
ADMIN_PASSWORD=
